//@title Fibonacci pairs (the classic Janus program)
//@desc Recursion in a reversible language. Run it, then uncall it: (x1, x2) = (F(n+1), F(n+2)) turns back into (0, 0).
int n = 16
int x1
int x2

procedure main()
  call fib(n, x1, x2)
  write x1
  write x2

// After the call: x1 = F(n+1), x2 = F(n+2).
procedure fib(int n, int x1, int x2)
  if n = 0 then
    x1 += 1
    x2 += 1
  else
    n -= 1
    call fib(n, x1, x2)
    x1 += x2
    x1 <=> x2
    n += 1
  fi x1 = x2
